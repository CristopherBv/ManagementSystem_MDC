<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.almacenista.DespachoController"
      spacing="15" style="-fx-padding: 20;" styleClass="main-content">

    <HBox spacing="10" alignment="CENTER_LEFT" styleClass="search-bar-container">
        <Label text="🔍 Filtrar Pendientes:" style="-fx-text-fill: white; -fx-font-weight: bold;"/>
        <TextField fx:id="txtBusqueda" promptText="Escriba ID de ticket o cliente..."
                   HBox.hgrow="ALWAYS" styleClass="modern-textfield"/>
    </HBox>

    <TableView fx:id="tablaDespacho" VBox.vgrow="ALWAYS" styleClass="modern-table">
        <columns>
            <TableColumn fx:id="colTicket" text="N° Ticket" prefWidth="120" resizable="false"/>
            <TableColumn fx:id="colCliente" text="Cliente habitual" prefWidth="250" />
            <TableColumn fx:id="colDetalles" text="Materiales solicitados" prefWidth="450" />
            <TableColumn fx:id="colAccion" text="Acción Operativa" prefWidth="150" resizable="false"/>
        </columns>
    </TableView>
</VBox>