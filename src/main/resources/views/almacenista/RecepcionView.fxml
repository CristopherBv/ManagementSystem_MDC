<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="15" styleClass="almacen-root"
      xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.almacenista.RecepcionController">

    <VBox spacing="10" style="-fx-background-color: #1a1d24; -fx-padding: 15; -fx-background-radius: 10; -fx-border-color: #272a33; -fx-border-radius: 10;">
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label text="PROVEEDORES EN TRÁNSITO (ÓRDENES EMITIDAS)" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px;"/>
            <Pane HBox.hgrow="ALWAYS"/>
            <TextField fx:id="txtBuscar" promptText="🔍 Buscar folio..." prefWidth="250" prefHeight="35" styleClass="search-input"/>
        </HBox>

        <ListView fx:id="listOrdenes" orientation="HORIZONTAL" prefHeight="90" minHeight="90"
                  style="-fx-background-color: transparent; -fx-control-inner-background: transparent; -fx-padding: 5 0;"/>
    </VBox>

    <VBox spacing="15" VBox.vgrow="ALWAYS" style="-fx-background-color: #1a1d24; -fx-padding: 20; -fx-background-radius: 10; -fx-border-color: #272a33; -fx-border-radius: 10;">

        <HBox alignment="CENTER_LEFT" spacing="15" style="-fx-border-color: #374151; -fx-border-width: 0 0 1 0; -fx-padding: 0 0 15 0;">
            <VBox>
                <Label fx:id="lblOrdenSeleccionada" text="Seleccione una orden del carrusel" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label fx:id="lblProveedor" text="-- Esperando camión --" style="-fx-text-fill: #9ca3af; -fx-font-size: 14px;"/>
            </VBox>
            <Pane HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblEstado" text="--" style="-fx-font-weight: bold; -fx-padding: 8 16; -fx-background-radius: 6; -fx-background-color: #374151; -fx-text-fill: #9ca3af;"/>
        </HBox>

        <TableView fx:id="tablaRecepcion" VBox.vgrow="ALWAYS" styleClass="data-table">
            <placeholder>
                <Label text="No hay productos listados en esta orden."/>
            </placeholder>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colProducto" text="MATERIAL ESPERADO"/>
                <TableColumn fx:id="colEsperado" text="CANT. ESPERADA" maxWidth="150" minWidth="150"/>
                <TableColumn fx:id="colRecibido" text="CONTEO FÍSICO" maxWidth="200" minWidth="200"/>
            </columns>
        </TableView>

        <Button fx:id="btnConfirmar" text="📥 REGISTRAR INGRESO AL INVENTARIO" onAction="#handleRegistrarEntrada"
                prefHeight="60" maxWidth="Infinity" disable="true"
                style="-fx-background-color: #F58220; -fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
    </VBox>

</VBox>