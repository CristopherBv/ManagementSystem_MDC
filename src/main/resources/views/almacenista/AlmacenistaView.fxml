<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.almacenista.AlmacenistaController"
      styleClass="almacen-root" stylesheets="@../../css/almacenista.css"
      prefHeight="720.0" prefWidth="1080.0">

    <HBox style="-fx-background-color: #111318; -fx-padding: 10 20; -fx-border-color: #272a33; -fx-border-width: 0 0 1 0;"
          alignment="CENTER_RIGHT" spacing="15">
        <Pane HBox.hgrow="ALWAYS"/>
        <VBox alignment="CENTER_RIGHT">
            <Label fx:id="lblUserName" text="Cargando usuario..." style="-fx-text-fill: #ffffff; -fx-font-size: 14px; -fx-font-weight: bold;"/>
            <HBox spacing="10">
                <Label fx:id="lblFecha" text="--" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
                <Label fx:id="lblHora" text="--" style="-fx-text-fill: #9ca3af; -fx-font-size: 12px;"/>
            </HBox>
        </VBox>
        <Button fx:id="btnLogout" text="Cerrar Sesión ✕" onAction="#handleLogout" styleClass="btn-logout-tablet"/>
    </HBox>

    <HBox styleClass="navigation-bar-tablet" spacing="20" alignment="CENTER_LEFT" prefHeight="90">

        <HBox fx:id="cardDespacho" onMouseClicked="#showDespacho" styleClass="card-touch-button" alignment="CENTER_LEFT" spacing="15" prefWidth="300">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="DESPACHO DE MATERIALES" styleClass="card-touch-title"/>
                <Label text="Salidas por ticket de venta" styleClass="card-touch-subtitle"/>
            </VBox>
            <StackPane styleClass="badge-circle, badge-blue">
                <Label fx:id="lblCountDespacho" text="0" styleClass="badge-text"/>
            </StackPane>
        </HBox>

        <HBox fx:id="cardRecepcion" onMouseClicked="#showRecepcion" styleClass="card-touch-button" alignment="CENTER_LEFT" spacing="15" prefWidth="300">
            <VBox alignment="CENTER_LEFT" HBox.hgrow="ALWAYS">
                <Label text="RECEPCIÓN DE STOCK" styleClass="card-touch-title"/>
                <Label text="Entradas por orden de compra" styleClass="card-touch-subtitle"/>
            </VBox>
            <StackPane styleClass="badge-circle, badge-orange">
                <Label fx:id="lblCountRecepcion" text="0" styleClass="badge-text"/>
            </StackPane>
        </HBox>
    </HBox>

    <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" style="-fx-padding: 15;"/>

</VBox>