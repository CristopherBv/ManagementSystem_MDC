<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="view-panel"
      xmlns="http://javafx.com/javafx/17.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.GerenteInventarioController">

    <HBox spacing="14">
        <VBox styleClass="kpi-card, kpi-orange" HBox.hgrow="ALWAYS">
            <Label text="MATERIALES EN STOCK" styleClass="kpi-label"/>
            <Label fx:id="kpiStock" text="--" styleClass="kpi-value"/>
            <Label text="Ítems registrados" styleClass="kpi-sub"/>
        </VBox>
        <VBox styleClass="kpi-card, kpi-red" HBox.hgrow="ALWAYS">
            <Label text="ALERTAS STOCK" styleClass="kpi-label"/>
            <Label fx:id="kpiAlertas" text="--" styleClass="kpi-value"/>
            <Label text="Bajo mínimo o críticos" styleClass="kpi-sub"/>
        </VBox>
    </HBox>

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtSearch" promptText="Buscar material..." prefHeight="36" prefWidth="260" styleClass="search-input"/>
        <ComboBox fx:id="cmbCategoria" promptText="Categoría" prefHeight="36" prefWidth="150" styleClass="combo-input"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAgregar" text="+ Agregar" onAction="#handleAgregar" prefHeight="36" styleClass="btn-add"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#handleEditar" prefHeight="36" styleClass="btn-edit"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" prefHeight="36" styleClass="btn-delete"/>
    </HBox>

    <TableView fx:id="tableInventario" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80" minWidth="80" maxWidth="90"/>
            <TableColumn fx:id="colNombre" text="MATERIAL" prefWidth="200"/>
            <TableColumn fx:id="colMarca" text="MARCA" prefWidth="110" minWidth="110" maxWidth="130"/>
            <TableColumn fx:id="colCantidad" text="CANTIDAD" prefWidth="80" minWidth="80" maxWidth="90"/>
            <TableColumn fx:id="colUnidad" text="UNIDAD" prefWidth="75" minWidth="75" maxWidth="80"/>
            <TableColumn fx:id="colStock" text="STOCK MÍN." prefWidth="80" minWidth="80" maxWidth="100"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="110" minWidth="110" maxWidth="130"/>
        </columns>
        <placeholder>
            <Label text="No hay productos registrados."/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer">
        <Label fx:id="lblTotal" text="Total: 0 registros" styleClass="footer-info"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnExportar" text="↓ Exportar" onAction="#handleExportar" prefHeight="30" styleClass="btn-ghost"/>
        <Button fx:id="btnActualizar" text="↺ Actualizar" onAction="#handleActualizar" prefHeight="30" styleClass="btn-ghost"/>
    </HBox>

</VBox>