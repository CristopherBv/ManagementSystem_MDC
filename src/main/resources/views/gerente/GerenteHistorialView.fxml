<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="view-panel"
      xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.gerente.GerenteHistorialController">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="15">
        <TextField fx:id="txtBuscarVenta" promptText="Buscar por ID de venta o fecha..." HBox.hgrow="ALWAYS" prefHeight="36" styleClass="search-input"/>
        <Label text="Filtrar Estado:" styleClass="footer-info"/>
        <ComboBox fx:id="cmbFiltroEstado" prefWidth="160" prefHeight="36" styleClass="combo-input"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnVerDetalle" text="🔍 Ver Detalle Completo" onAction="#handleVerDetalleVenta" prefHeight="36" styleClass="btn-edit"/>
    </HBox>

    <TableView fx:id="tableHistorial" VBox.vgrow="ALWAYS" styleClass="data-table">
        <placeholder>
            <Label text="No se han encontrado registros de ventas con estos filtros."/>
        </placeholder>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" maxWidth="80"/>
            <TableColumn fx:id="colFecha" text="FECHA Y HORA" prefWidth="180"/>
            <TableColumn fx:id="colCliente" text="CLIENTE" prefWidth="200"/>
            <TableColumn fx:id="colTipo" text="TIPO" prefWidth="110"/>
            <TableColumn fx:id="colMetodo" text="MÉTODO" prefWidth="110"/>
            <TableColumn fx:id="colTotal" text="TOTAL" prefWidth="120"/>
            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox alignment="CENTER_RIGHT" styleClass="table-footer">
        <Label fx:id="lblFooter" text="Mostrando 0 registros" styleClass="footer-info"/>
    </HBox>

</VBox>