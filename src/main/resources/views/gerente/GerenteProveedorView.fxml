<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="view-panel"
      xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.gerente.GerenteProveedorController">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtSearch" promptText="Buscar proveedor..." prefHeight="36" prefWidth="300" styleClass="search-input"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAgregar" text="+ Nuevo Proveedor" onAction="#handleAgregar" prefHeight="36" styleClass="btn-add"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#handleEditar" prefHeight="36" styleClass="btn-edit"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminar" prefHeight="36" styleClass="btn-delete"/>
    </HBox>

    <TableView fx:id="tableProveedores" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="120" minWidth="120" maxWidth="180"/>
            <TableColumn fx:id="colNombre" text="EMPRESA / PROVEEDOR" prefWidth="200"/>
            <TableColumn fx:id="colTelefono" text="TELÉFONO DE CONTACTO" prefWidth="200" minWidth="200" maxWidth="250"/>
        </columns>
        <placeholder>
            <Label text="No hay proveedores registrados en el directorio."/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer">
        <Label fx:id="lblTotal" text="Total: 0 proveedores" styleClass="footer-info"/>
    </HBox>

</VBox>