<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="14" styleClass="view-panel"
      xmlns="http://javafx.com/javafx/17.0.2" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.gerente.GerenteClienteController">

    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
        <TextField fx:id="txtSearch" promptText="Buscar por nombre o teléfono..." prefHeight="36" prefWidth="300" styleClass="search-input"/>
        <Pane HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnAgregar" text="+ Nuevo Cliente" onAction="#handleNuevoCliente" prefHeight="36" styleClass="btn-add"/>
        <Button fx:id="btnEditar" text="Editar" onAction="#handleEditarCliente" prefHeight="36" styleClass="btn-edit"/>
        <Button fx:id="btnEliminar" text="Eliminar" onAction="#handleEliminarCliente" prefHeight="36" styleClass="btn-delete"/>
    </HBox>

    <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS" styleClass="data-table">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60" minWidth="60" maxWidth="70"/>
            <TableColumn fx:id="colNombre" text="NOMBRE" prefWidth="130" minWidth="130" maxWidth="140"/>
            <TableColumn fx:id="colTelefono" text="TELÉFONO" prefWidth="110" minWidth="110" maxWidth="120"/>
            <TableColumn fx:id="colEmail" text="EMAIL" prefWidth="120" minWidth="120" maxWidth="140"/>
            <TableColumn fx:id="colDireccion" text="DIRECCIÓN" prefWidth="160" minWidth="160" maxWidth="170"/>
            <TableColumn fx:id="colPuntos" text="PUNTOS" prefWidth="60" minWidth="60" maxWidth="70"/>
            <TableColumn fx:id="colPreferencias" text="PREFERENCIAS" prefWidth="200"/>
        </columns>
        <placeholder>
            <Label text="No hay clientes registrados en la cartera."/>
        </placeholder>
    </TableView>

    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer">
        <Label fx:id="lblTotal" text="Total: 0 clientes" styleClass="footer-info"/>
    </HBox>

</VBox>