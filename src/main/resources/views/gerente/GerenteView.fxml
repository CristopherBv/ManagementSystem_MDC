<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="680.0" prefWidth="1160.0"
            styleClass="root-pane"
            stylesheets="@../../css/gerente.css"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionmats.controllers.gerente.GerenteController">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="0">
            <Pane styleClass="sidebar-accent" prefHeight="4"/>
            <VBox styleClass="sidebar-profile" alignment="CENTER" spacing="10">
                <StackPane styleClass="avatar-ring" minWidth="64" minHeight="64" prefWidth="64" prefHeight="64" maxWidth="64" maxHeight="64">
                    <Label text="G" styleClass="avatar-letter"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="3">
                    <Label fx:id="lblUserName" text="Gerente" styleClass="profile-name"/>
                    <HBox alignment="CENTER" spacing="5">
                        <Circle styleClass="status-dot" radius="4"/>
                        <Label text="EN LÍNEA" styleClass="profile-role"/>
                    </HBox>
                </VBox>
            </VBox>

            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="MÓDULOS" styleClass="nav-section-label"/>

                <Button fx:id="navDashboard" text="  Panel de Control" onAction="#showDashboard"
                        prefWidth="220" prefHeight="44" styleClass="nav-btn"/>

                <Button fx:id="navInventario" text="  Inventario" onAction="#showInventario"
                        prefWidth="220" prefHeight="44" styleClass="nav-btn"/>

                <Button fx:id="navPedidos" text="  Pedidos" onAction="#showPedidos"
                        prefWidth="220" prefHeight="44" styleClass="nav-btn"/>

                <Button fx:id="navClientes" text="  Clientes" onAction="#showClientes"
                        prefWidth="220" prefHeight="44" styleClass="nav-btn"/>

                <Button fx:id="navProveedores" text="  Proveedores" onAction="#showProveedores"
                        prefWidth="220" prefHeight="44" styleClass="nav-btn"/>
            </VBox>

            <VBox styleClass="sidebar-footer" alignment="CENTER">
                <Button fx:id="btnLogout" text="Cerrar Sesión" onAction="#handleLogout"
                        prefWidth="180" prefHeight="38" styleClass="btn-logout"/>
                <Label text="SDG HUB · v2.1.0" styleClass="sidebar-version"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content">
            <HBox styleClass="topbar" alignment="CENTER_LEFT">

                <Pane styleClass="topbar-accent" prefWidth="5" maxHeight="40"/>

                <VBox styleClass="topbar-titles" spacing="2">
                    <Label fx:id="lblPageTitle" text="Panel de Control" styleClass="page-title"/>
                    <Label fx:id="lblPageSub" text="Bienvenido, Usuario" styleClass="page-subtitle"/>
                </VBox>

                <Pane HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="topbar-time">
                    <Label fx:id="lblFecha" text="--" styleClass="time-date"/>
                    <Label fx:id="lblHora" text="00:00" styleClass="time-clock"/>
                </VBox>
            </HBox>

            <StackPane fx:id="contentArea" VBox.vgrow="ALWAYS" styleClass="dynamic-pane"/>
        </VBox>
    </center>
</BorderPane>