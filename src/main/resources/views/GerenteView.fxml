<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<BorderPane prefHeight="620.0" prefWidth="960.0"
            styleClass="root-pane"
            stylesheets="@../css/gerente.css"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionmats.controllers.GerenteController">

    <!-- ═══════════════════════════════════════
         SIDEBAR IZQUIERDO
    ═══════════════════════════════════════ -->
    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="0">

            <!-- Barra de acento superior -->
            <Pane styleClass="sidebar-accent" prefHeight="4"/>

            <!-- Perfil del usuario -->
            <VBox styleClass="sidebar-profile" alignment="CENTER" spacing="10">
                <StackPane styleClass="avatar-ring" prefWidth="64" prefHeight="64"
                           maxWidth="64" maxHeight="64">
                    <Label text="G" styleClass="avatar-letter"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="3">
                    <Label fx:id="lblUserName" text="Gerente" styleClass="profile-name"/>
                    <HBox alignment="CENTER" spacing="5">
                        <Circle styleClass="status-dot" radius="4"/>
                        <Label text="EN LÍNEA" styleClass="profile-role"/>
                    </HBox>
                </VBox>
            </VBox>

            <!-- Separador -->
            <Pane styleClass="sidebar-divider" prefHeight="1" maxWidth="1000"/>

            <!-- Menú de navegación -->
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">

                <Label text="MÓDULOS" styleClass="nav-section-label"/>

                <Button fx:id="navInventario" text="  Inventario"
                        onAction="#showInventario"
                        prefWidth="220" prefHeight="44"
                        styleClass="nav-btn, nav-btn-active">
                    <graphic>
                        <Label text="📦" styleClass="nav-icon"/>
                    </graphic>
                </Button>

                <Button fx:id="navPedidos" text="  Pedidos"
                        onAction="#showPedidos"
                        prefWidth="220" prefHeight="44"
                        styleClass="nav-btn">
                    <graphic>
                        <Label text="📋" styleClass="nav-icon"/>
                    </graphic>
                </Button>

                <Button fx:id="navProveedores" text="  Proveedores"
                        onAction="#showProveedores"
                        prefWidth="220" prefHeight="44"
                        styleClass="nav-btn">
                    <graphic>
                        <Label text="🏭" styleClass="nav-icon"/>
                    </graphic>
                </Button>

                <Button fx:id="navReportes" text="  Reportes"
                        onAction="#showReportes"
                        prefWidth="220" prefHeight="44"
                        styleClass="nav-btn">
                    <graphic>
                        <Label text="📊" styleClass="nav-icon"/>
                    </graphic>
                </Button>

                <Label text="SISTEMA" styleClass="nav-section-label"/>

                <Button fx:id="navConfig" text="  Configuración"
                        onAction="#showConfig"
                        prefWidth="220" prefHeight="44"
                        styleClass="nav-btn">
                    <graphic>
                        <Label text="⚙" styleClass="nav-icon"/>
                    </graphic>
                </Button>

            </VBox>

            <!-- Botón cerrar sesión -->
            <Pane styleClass="sidebar-divider" prefHeight="1" maxWidth="1000"/>
            <VBox styleClass="sidebar-footer" alignment="CENTER">
                <Button fx:id="btnLogout" text="Cerrar Sesión"
                        onAction="#handleLogout"
                        prefWidth="180" prefHeight="38"
                        styleClass="btn-logout"/>
                <Label text="SDG MDC · v2.0.1" styleClass="sidebar-version"/>
            </VBox>

        </VBox>
    </left>

    <!-- ═══════════════════════════════════════
         CONTENIDO PRINCIPAL
    ═══════════════════════════════════════ -->
    <center>
        <VBox styleClass="main-content" spacing="0">

            <!-- TOPBAR -->
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="0">
                <Pane styleClass="topbar-accent" prefWidth="3" prefHeight="44"/>
                <VBox styleClass="topbar-titles" spacing="2">
                    <Label fx:id="lblPageTitle" text="Inventario" styleClass="page-title"/>
                    <Label fx:id="lblPageSub" text="Control y seguimiento de materiales"
                           styleClass="page-subtitle"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <!-- Fecha/hora -->
                <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="topbar-time">
                    <Label fx:id="lblFecha" text="Miércoles, 29 Abr 2026" styleClass="time-date"/>
                    <Label fx:id="lblHora" text="10:30" styleClass="time-clock"/>
                </VBox>
            </HBox>

            <!-- TARJETAS KPI -->
            <HBox styleClass="kpi-row" spacing="14">

                <VBox styleClass="kpi-card, kpi-orange" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="MATERIALES EN STOCK" styleClass="kpi-label"/>
                    <Label fx:id="kpiStock" text="—" styleClass="kpi-value"/>
                    <Label fx:id="kpiStockSub" text="Ítems registrados" styleClass="kpi-sub"/>
                </VBox>

                <VBox styleClass="kpi-card, kpi-blue" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="PEDIDOS ACTIVOS" styleClass="kpi-label"/>
                    <Label fx:id="kpiPedidos" text="—" styleClass="kpi-value"/>
                    <Label fx:id="kpiPedidosSub" text="En proceso" styleClass="kpi-sub"/>
                </VBox>

                <VBox styleClass="kpi-card, kpi-green" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="PROVEEDORES" styleClass="kpi-label"/>
                    <Label fx:id="kpiProveedores" text="—" styleClass="kpi-value"/>
                    <Label fx:id="kpiProveedoresSub" text="Activos" styleClass="kpi-sub"/>
                </VBox>

                <VBox styleClass="kpi-card, kpi-red" HBox.hgrow="ALWAYS" spacing="6">
                    <Label text="ALERTAS STOCK" styleClass="kpi-label"/>
                    <Label fx:id="kpiAlertas" text="—" styleClass="kpi-value"/>
                    <Label fx:id="kpiAlertasSub" text="Bajo mínimo" styleClass="kpi-sub"/>
                </VBox>

            </HBox>

            <!-- PANEL DINÁMICO (cambia según nav) -->
            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="dynamic-pane">

                <!-- ── VISTA INVENTARIO (default) ── -->
                <VBox fx:id="viewInventario" spacing="14" styleClass="view-panel">

                    <!-- Barra de herramientas -->
                    <HBox styleClass="toolbar" alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="txtSearch"
                                   promptText="Buscar material..."
                                   prefHeight="36" prefWidth="260"
                                   styleClass="search-input"/>
                        <ComboBox fx:id="cmbCategoria"
                                  promptText="Categoría"
                                  prefHeight="36" prefWidth="150"
                                  styleClass="combo-input"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnAgregar" text="+ Agregar"
                                onAction="#handleAgregar"
                                prefHeight="36" styleClass="btn-add"/>
                        <Button fx:id="btnEditar" text="Editar"
                                onAction="#handleEditar"
                                prefHeight="36" styleClass="btn-edit"/>
                        <Button fx:id="btnEliminar" text="Eliminar"
                                onAction="#handleEliminar"
                                prefHeight="36" styleClass="btn-delete"/>
                    </HBox>

                    <!-- Tabla -->
                    <TableView fx:id="tableInventario"
                               VBox.vgrow="ALWAYS"
                               styleClass="data-table">
                        <!-- Definimos el placeholder como un nodo hijo -->
                        <placeholder>
                            <Label text="Sin materiales registrados"/>
                        </placeholder>

                        <columns>
                            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colNombre" text="MATERIAL" prefWidth="200"/>
                            <TableColumn fx:id="colCategoria" text="CATEGORÍA" prefWidth="130"/>
                            <TableColumn fx:id="colCantidad" text="CANTIDAD" prefWidth="100"/>
                            <TableColumn fx:id="colUnidad" text="UNIDAD" prefWidth="90"/>
                            <TableColumn fx:id="colStock" text="STOCK MÍN." prefWidth="100"/>
                            <TableColumn fx:id="colEstado" text="ESTADO" prefWidth="100"/>
                        </columns>

                    </TableView>

                    <!-- Footer tabla -->
                    <HBox alignment="CENTER_LEFT" spacing="10" styleClass="table-footer">
                        <Label fx:id="lblTotal" text="Total: 0 registros" styleClass="footer-info"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnExportar" text="↓ Exportar"
                                onAction="#handleExportar"
                                prefHeight="30" styleClass="btn-ghost"/>
                        <Button fx:id="btnActualizar" text="↺ Actualizar"
                                onAction="#handleActualizar"
                                prefHeight="30" styleClass="btn-ghost"/>
                    </HBox>

                </VBox>

                <!-- ── PLACEHOLDER vistas futuras ── -->
                <VBox fx:id="viewPedidos"   visible="false" managed="false" styleClass="view-panel, placeholder-view" alignment="CENTER">
                    <Label text="📋" styleClass="placeholder-icon"/>
                    <Label text="Módulo de Pedidos" styleClass="placeholder-title"/>
                    <Label text="Próximamente disponible" styleClass="placeholder-sub"/>
                </VBox>

                <VBox fx:id="viewProveedores" visible="false" managed="false" styleClass="view-panel, placeholder-view" alignment="CENTER">
                    <Label text="🏭" styleClass="placeholder-icon"/>
                    <Label text="Módulo de Proveedores" styleClass="placeholder-title"/>
                    <Label text="Próximamente disponible" styleClass="placeholder-sub"/>
                </VBox>

                <VBox fx:id="viewReportes" visible="false" managed="false" styleClass="view-panel, placeholder-view" alignment="CENTER">
                    <Label text="📊" styleClass="placeholder-icon"/>
                    <Label text="Módulo de Reportes" styleClass="placeholder-title"/>
                    <Label text="Próximamente disponible" styleClass="placeholder-sub"/>
                </VBox>

                <VBox fx:id="viewConfig" visible="false" managed="false" styleClass="view-panel, placeholder-view" alignment="CENTER">
                    <Label text="⚙" styleClass="placeholder-icon"/>
                    <Label text="Configuración del Sistema" styleClass="placeholder-title"/>
                    <Label text="Próximamente disponible" styleClass="placeholder-sub"/>
                </VBox>

            </StackPane>

        </VBox>
    </center>

</BorderPane>