<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="560.0" prefWidth="780.0"
            styleClass="login-root"
            stylesheets="@../css/login.css"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionmats.controllers.LoginController">

    <children>

        <!-- ═══ PANEL IZQUIERDO – Identidad Visual ═══ -->
        <VBox styleClass="brand-panel"
              alignment="CENTER"
              spacing="0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="0.0"
              AnchorPane.rightAnchor="390.0">

            <!-- Patrón decorativo superior -->
            <Pane styleClass="brand-pattern" prefHeight="6" maxWidth="1000"/>

            <VBox alignment="CENTER" spacing="22" VBox.vgrow="ALWAYS">

                <!-- Logo -->
                <StackPane styleClass="logo-ring" prefWidth="112" prefHeight="112" maxWidth="112" maxHeight="112">
                    <ImageView fitHeight="72" fitWidth="72" preserveRatio="true">
                        <image>
                            <Image url="@../images/logoConstructoraV1.png"/>
                        </image>
                    </ImageView>
                </StackPane>

                <!-- Nombre de empresa -->
                <VBox alignment="CENTER" spacing="6">
                    <Label text="CONSTRUCT HUB" styleClass="brand-name"/>
                    <HBox alignment="CENTER" spacing="10">
                        <Region styleClass="brand-line" prefWidth="45" minHeight="1" maxHeight="1"/>
                        <Label text="GESTIÓN DE MATERIALES DE CONSTRUCCION" styleClass="brand-tagline"/>
                        <Region styleClass="brand-line" prefWidth="45" minHeight="1" maxHeight="1"/>
                    </HBox>
                </VBox>

                <!-- Separador decorativo -->
                <Pane styleClass="brand-separator" prefHeight="1" prefWidth="140"/>

                <!-- Descripción -->
                <VBox alignment="CENTER" spacing="10" maxWidth="260">
                    <Label text="Sistema integrado de control y seguimiento de inventario y de operaciones de manera efectiva, eficiente y precisa."
                           styleClass="brand-description"
                           wrapText="true"
                           textAlignment="CENTER"/>
                </VBox>

                <!-- Stats decorativos -->
                <HBox alignment="CENTER" spacing="0" styleClass="stats-row" maxWidth="330">

                    <VBox alignment="CENTER" spacing="3" styleClass="stat-item" HBox.hgrow="ALWAYS">
                        <Label text="INVENTARIO" styleClass="stat-label"/>
                        <Label text="TOTAL" styleClass="stat-sub"/>
                    </VBox>

                    <Region styleClass="stat-divider" minWidth="1" maxWidth="1" prefHeight="32"/>

                    <VBox alignment="CENTER" spacing="3" styleClass="stat-item" HBox.hgrow="ALWAYS">
                        <Label text="PEDIDOS" styleClass="stat-label"/>
                        <Label text="ACTIVOS" styleClass="stat-sub"/>
                    </VBox>

                    <Region styleClass="stat-divider" minWidth="1" maxWidth="1" prefHeight="32"/>

                    <VBox alignment="CENTER" spacing="3" styleClass="stat-item" HBox.hgrow="ALWAYS">
                        <Label text="REPORTES" styleClass="stat-label"/>
                        <Label text="EN TIEMPO REAL" styleClass="stat-sub"/>
                    </VBox>

                </HBox>

            </VBox>

            <!-- Footer del panel izquierdo -->
            <Label text="© 2026 CONSTRUCT HUB. Todos los derechos reservados a Netanyahu."
                   styleClass="brand-footer"
                   VBox.vgrow="NEVER"/>
            <Pane prefHeight="20"/>

        </VBox>

        <!-- ═══ PANEL DERECHO – Formulario ═══ -->
        <VBox styleClass="form-panel"
              alignment="CENTER"
              spacing="0"
              AnchorPane.topAnchor="0.0"
              AnchorPane.bottomAnchor="0.0"
              AnchorPane.leftAnchor="390.0"
              AnchorPane.rightAnchor="0.0">

            <!-- Accent top bar -->
            <Pane styleClass="form-accent-bar" prefHeight="4" maxWidth="1000"/>

            <VBox fx:id="loginContainer"
                  alignment="CENTER"
                  spacing="0"
                  VBox.vgrow="ALWAYS"
                  styleClass="form-inner">

                <!-- Encabezado del formulario -->
                <VBox spacing="6" styleClass="form-header">
                    <Label text="Bienvenido" styleClass="form-title"/>
                    <Label text="Ingrese sus credenciales para continuar" styleClass="form-subtitle"/>
                </VBox>

                <Pane prefHeight="32"/>

                <!-- FORM FIELDS -->
                <VBox spacing="18" maxWidth="300" prefWidth="300">

                    <!-- Campo Usuario -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="USUARIO" styleClass="field-label"/>
                        </HBox>
                        <StackPane styleClass="input-wrapper">
                            <TextField fx:id="txtUser"
                                       promptText="Ingrese su usuario"
                                       prefHeight="46"
                                       styleClass="input"
                                       StackPane.alignment="CENTER_LEFT"/>
                        </StackPane>
                    </VBox>

                    <!-- Campo Contraseña -->
                    <VBox spacing="6">
                        <HBox alignment="CENTER_LEFT" spacing="6">
                            <Label text="CONTRASEÑA" styleClass="field-label"/>
                        </HBox>
                        <StackPane styleClass="input-wrapper">
                            <AnchorPane prefHeight="46" maxWidth="1000" HBox.hgrow="ALWAYS"
                                        AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

                                <TextField fx:id="txtPasswordVisible"
                                           managed="false"
                                           visible="false"
                                           prefHeight="46"
                                           promptText="••••••••"
                                           styleClass="input, password-input"
                                           AnchorPane.leftAnchor="0.0"
                                           AnchorPane.rightAnchor="0.0"/>

                                <PasswordField fx:id="txtPasswordHidden"
                                               prefHeight="46"
                                               promptText="••••••••"
                                               styleClass="input, password-input"
                                               AnchorPane.leftAnchor="0.0"
                                               AnchorPane.rightAnchor="0.0"/>

                                <ToggleButton fx:id="btnTogglePass"
                                              onAction="#togglePasswordVisibility"
                                              prefHeight="32"
                                              prefWidth="32"
                                              styleClass="eye-btn"
                                              AnchorPane.rightAnchor="7"
                                              AnchorPane.topAnchor="7">
                                    <graphic>
                                        <ImageView fx:id="imgEye"
                                                   fitHeight="18"
                                                   fitWidth="18"
                                                   preserveRatio="true">
                                            <image>
                                                <Image url="@../images/ojoCerrado_Naranja.png"/>
                                            </image>
                                        </ImageView>
                                    </graphic>
                                </ToggleButton>

                            </AnchorPane>
                        </StackPane>
                    </VBox>

                    <!-- Error global -->
                    <HBox fx:id="errorBox" alignment="CENTER_LEFT" spacing="6"
                          styleClass="error-box" visible="false" managed="false">
                        <Label text="⚠" styleClass="error-icon"/>
                        <Label fx:id="lblError"
                               text="Credenciales incorrectas. Verifique sus datos."
                               styleClass="error-label"
                               wrapText="true"/>
                    </HBox>

                </VBox>

                <Pane prefHeight="28"/>

                <!-- BOTÓN DE INGRESO -->
                <StackPane prefWidth="300" prefHeight="48">
                    <Button fx:id="btnLogin"
                            text="INGRESAR"
                            prefWidth="300"
                            prefHeight="48"
                            onAction="#handleLogin"
                            styleClass="btn-primary"/>
                    <ProgressIndicator fx:id="loadingSpinner"
                                       visible="false"
                                       prefWidth="22"
                                       prefHeight="22"/>
                </StackPane>

                <Pane prefHeight="20"/>

                <!-- Ayuda -->
                <Label text="¿Problemas para acceder? Contacte a soporte técnico."
                       styleClass="help-text"
                       textAlignment="CENTER"
                       maxWidth="280"
                       wrapText="true"/>

            </VBox>

            <!-- Version tag -->
            <Label text="vAlpha · Build Inestable" styleClass="version-tag"/>
            <Pane prefHeight="16"/>

        </VBox>

    </children>
</AnchorPane>