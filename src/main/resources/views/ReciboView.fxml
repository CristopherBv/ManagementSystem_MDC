<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gestionmats.controllers.ReciboController"
      spacing="10" alignment="CENTER"
      prefWidth="600" prefHeight="500"
      style="-fx-background-color: #ffffff; -fx-padding: 20;">

    <Label text="RECIBO DE COMPRA"
           style="-fx-text-fill: #000000; -fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Separator/>

    <TextArea fx:id="txtRecibo" editable="false"
              style="-fx-background-color: #f5f5f5; -fx-text-fill: #000000; -fx-font-family: monospace; -fx-font-size: 12px;"
              prefHeight="350" prefWidth="550"/>

    <Separator/>

    <HBox alignment="CENTER" spacing="10">
        <Button text="Cerrar" onAction="#handleCerrar"
                style="-fx-background-color: #F58220; -fx-text-fill: #ffffff; -fx-cursor: hand; -fx-padding: 8 20;"/>
    </HBox>

</VBox>