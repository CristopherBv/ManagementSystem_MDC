<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<BorderPane prefHeight="720.0" prefWidth="1200.0"
            styleClass="root-pane"
            stylesheets="@../css/vendedor.css"
            xmlns="http://javafx.com/javafx/17.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="gestionmats.controllers.VendedorController">

    <left>
        <VBox styleClass="sidebar" prefWidth="220" spacing="0">
            <Pane styleClass="sidebar-accent" prefHeight="4"/>
            <VBox styleClass="sidebar-profile" alignment="CENTER" spacing="10">
                <StackPane styleClass="avatar-ring" prefWidth="64" prefHeight="64">
                    <Label text="V" styleClass="avatar-letter"/>
                </StackPane>
                <VBox alignment="CENTER" spacing="3">
                    <Label fx:id="lblVendedorNombre" text="Vendedor" styleClass="profile-name"/>
                    <HBox alignment="CENTER" spacing="5">
                        <Circle styleClass="status-dot" radius="4"/>
                        <Label text="EN LINEA" styleClass="profile-role"/>
                    </HBox>
                </VBox>
            </VBox>
            <Pane styleClass="sidebar-divider" prefHeight="1"/>
            <VBox styleClass="nav-section" spacing="2" VBox.vgrow="ALWAYS">
                <Label text="MODULOS" styleClass="nav-section-label"/>
                <Button fx:id="navVentas" text="Punto de Venta" onAction="#showVentas" prefWidth="220" prefHeight="44" styleClass="nav-btn">
                    <graphic><Label text="🛒" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="navHistorial" text="Historial" onAction="#showHistorial" prefWidth="220" prefHeight="44" styleClass="nav-btn">
                    <graphic><Label text="📋" styleClass="nav-icon"/></graphic>
                </Button>
                <Button fx:id="navClientes" text="Clientes" onAction="#showClientes" prefWidth="220" prefHeight="44" styleClass="nav-btn">
                    <graphic><Label text="👥" styleClass="nav-icon"/></graphic>
                </Button>
            </VBox>
            <Pane styleClass="sidebar-divider" prefHeight="1"/>
            <VBox styleClass="sidebar-footer" alignment="CENTER">
                <Button fx:id="btnLogout" text="Cerrar Sesion" onAction="#handleLogout" prefWidth="180" prefHeight="38" styleClass="btn-logout"/>
                <Label text="SDG MDC v2.0.1" styleClass="sidebar-version"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="main-content" spacing="0">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="0">
                <Pane styleClass="topbar-accent" prefWidth="3" prefHeight="44"/>
                <VBox styleClass="topbar-titles" spacing="2">
                    <Label fx:id="lblPageTitle" text="Punto de Venta" styleClass="page-title"/>
                    <Label fx:id="lblPageSub" text="Registro de ventas y pedidos" styleClass="page-subtitle"/>
                </VBox>
                <Pane HBox.hgrow="ALWAYS"/>
                <VBox alignment="CENTER_RIGHT" spacing="2" styleClass="topbar-time">
                    <Label fx:id="lblFecha" styleClass="time-date"/>
                    <Label fx:id="lblHora" styleClass="time-clock"/>
                </VBox>
            </HBox>

            <StackPane fx:id="contentPane" VBox.vgrow="ALWAYS" styleClass="dynamic-pane">

                <!-- VISTA VENTAS -->
                <VBox fx:id="viewVentas" spacing="14" styleClass="view-panel">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <TextField fx:id="txtSearchProducto" promptText="Buscar producto..." prefHeight="36" prefWidth="260" styleClass="search-input"/>
                        <ComboBox fx:id="cmbCategoria" promptText="Categoria" prefHeight="36" prefWidth="180" styleClass="combo-input"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                    </HBox>

                    <TableView fx:id="tableProductos" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colIdProducto" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colNombreProducto" text="PRODUCTO" prefWidth="250"/>
                            <TableColumn fx:id="colCategoriaProducto" text="CATEGORIA" prefWidth="150"/>
                            <TableColumn fx:id="colStockProducto" text="STOCK" prefWidth="80"/>
                            <TableColumn fx:id="colPrecioProducto" text="PRECIO" prefWidth="100"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="10">
                        <Button fx:id="btnAgregarCarrito" text="Agregar al carrito" onAction="#handleAgregarAlCarrito" prefHeight="36" styleClass="btn-add"/>
                    </HBox>

                    <TableView fx:id="tableCarrito" prefHeight="180" VBox.vgrow="NEVER" styleClass="data-table">
                        <columnResizePolicy><TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/></columnResizePolicy>
                        <columns>
                            <TableColumn fx:id="colIdProdCarrito" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colNombreCarrito" text="PRODUCTO" prefWidth="250"/>
                            <TableColumn fx:id="colCantidadCarrito" text="CANT" prefWidth="80"/>
                            <TableColumn fx:id="colPrecioCarrito" text="PRECIO" prefWidth="120"/>
                            <TableColumn fx:id="colSubtotalCarrito" text="SUBTOTAL" prefWidth="120"/>
                            <TableColumn fx:id="colTotalCarrito" text="TOTAL" prefWidth="120"/>
                        </columns>
                    </TableView>

                    <HBox alignment="CENTER_RIGHT" spacing="15" styleClass="table-footer">
                        <Button fx:id="btnEliminarDelCarrito" text="Eliminar" onAction="#handleEliminarDelCarrito" prefHeight="32" styleClass="btn-delete"/>
                        <Pane HBox.hgrow="ALWAYS"/>
                        <VBox alignment="CENTER_RIGHT" spacing="4">
                            <HBox spacing="15"><Label text="Subtotal:"/><Label fx:id="lblSubtotal" text="0.00" styleClass="kpi-value"/></HBox>
                            <HBox spacing="15"><Label text="Descuento:"/><Label fx:id="lblDescuento" text="0" styleClass="kpi-orange"/></HBox>
                            <HBox spacing="15"><Label text="TOTAL:"/><Label fx:id="lblTotal" text="0.00" styleClass="kpi-value"/></HBox>
                        </VBox>
                    </HBox>

                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <Button fx:id="btnSeleccionarCliente" text="Seleccionar Cliente" onAction="#handleSeleccionarCliente" styleClass="btn-edit"/>
                        <Button fx:id="btnLimpiarCliente" text="Limpiar Cliente" onAction="#handleLimpiarCliente" styleClass="btn-ghost"/>
                        <Button fx:id="btnCanjearPuntos" text="Canjear Puntos" onAction="#handleCanjearPuntos" styleClass="btn-add"/>
                        <Label text="Cliente:"/><Label fx:id="lblClienteSeleccionado" text=""/><Label fx:id="lblPuntosCliente" text=""/>
                    </HBox>

                    <HBox alignment="CENTER_RIGHT" spacing="15">
                        <Label text="Metodo de pago:"/><ComboBox fx:id="cmbMetodoPago" prefWidth="150"/>
                        <Label text="Tipo de venta:"/><ComboBox fx:id="cmbTipoVenta" prefWidth="150"/>
                        <Button fx:id="btnAplicarDescuento" text="Aplicar descuento" onAction="#handleAplicarDescuento" styleClass="btn-edit"/>
                        <Button fx:id="btnFinalizarVenta" text="Finalizar venta" onAction="#handleFinalizarVenta" styleClass="btn-add"/>
                    </HBox>
                </VBox>

                <!-- VISTA HISTORIAL -->
                <VBox fx:id="viewHistorial" visible="false" managed="false" spacing="14" styleClass="view-panel">
                    <HBox alignment="CENTER_LEFT" spacing="15">
                        <TextField fx:id="txtBuscarVenta" promptText="Buscar por ID o fecha..." styleClass="search-input"/>
                        <Label text="Estado:"/><ComboBox fx:id="cmbFiltroEstado" prefWidth="150"/>
                        <Button text="Ver detalle" onAction="#handleVerDetalleVenta" styleClass="btn-edit"/>
                    </HBox>
                    <TableView fx:id="tableHistorial" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colHisId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colHisFecha" text="FECHA" prefWidth="160"/>
                            <TableColumn fx:id="colHisCliente" text="CLIENTE" prefWidth="180"/>
                            <TableColumn fx:id="colHisTipo" text="TIPO" prefWidth="100"/>
                            <TableColumn fx:id="colHisMetodo" text="METODO" prefWidth="100"/>
                            <TableColumn fx:id="colHisTotal" text="TOTAL" prefWidth="120"/>
                            <TableColumn fx:id="colHisEstado" text="ESTADO" prefWidth="100"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblFooterHistorial" text="Mostrando 0 ventas"/>
                </VBox>

                <!-- VISTA CLIENTES -->
                <VBox fx:id="viewClientes" visible="false" managed="false" spacing="14" styleClass="view-panel">
                    <HBox spacing="10">
                        <TextField fx:id="txtBuscarCliente" promptText="Buscar cliente..." styleClass="search-input"/>
                        <Button fx:id="btnNuevoCliente" text="Nuevo" onAction="#handleNuevoCliente" styleClass="btn-add"/>
                        <Button fx:id="btnEditarCliente" text="Editar" onAction="#handleEditarCliente" styleClass="btn-edit"/>
                        <Button fx:id="btnEliminarCliente" text="Eliminar" onAction="#handleEliminarCliente" styleClass="btn-delete"/>
                    </HBox>
                    <TableView fx:id="tableClientes" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colCliId" text="ID" prefWidth="60"/>
                            <TableColumn fx:id="colCliNombre" text="NOMBRE" prefWidth="180"/>
                            <TableColumn fx:id="colCliTelefono" text="TELEFONO" prefWidth="120"/>
                            <TableColumn fx:id="colCliEmail" text="EMAIL" prefWidth="180"/>
                            <TableColumn fx:id="colCliDireccion" text="DIRECCION" prefWidth="200"/>
                            <TableColumn fx:id="colCliPuntos" text="PUNTOS" prefWidth="80"/>
                            <TableColumn fx:id="colCliPreferencias" text="PREFERENCIAS" prefWidth="150"/>
                        </columns>
                    </TableView>
                    <Label fx:id="lblFooterClientes" text="Total: 0 clientes"/>
                </VBox>

            </StackPane>
        </VBox>
    </center>
</BorderPane>